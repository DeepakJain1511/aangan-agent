# Vaani webhook: put this in the webhook URL as ?token=...
VAANI_WEBHOOK_TOKEN=
# Gemini Flash (fact extraction). Optional: heuristic extractor is used if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Telegram handoff (designer group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# HubSpot CRM (private app token)
HUBSPOT_TOKEN=
# Supabase. Optional: a local JSON file store is used if empty.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard password (HTTP header x-dashboard-key or ?key=)
DASHBOARD_KEY=
# Cost model (USD per unit), used by the dashboard
USD_TO_INR=88
# Vaani does not report cost in webhooks: estimate = minutes x this rate (INR/min). Check your Vaani plan.
VOICE_COST_INR_PER_MIN=
